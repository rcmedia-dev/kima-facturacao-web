# ─── Variáveis de Ambiente para Modo Mock ───────────────────────────
# Copie este conteúdo para .env.local e defina NEXT_PUBLIC_USE_MOCK_DB=true
# para rodar a aplicação com dados mock (sem conexão ao Supabase).

# Supabase (manter para compatibilidade, mas não será usado)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=mock-anon-key
SUPABASE_SERVICE_ROLE_KEY=mock-service-key

# Modo Mock (ativo)
NEXT_PUBLIC_USE_MOCK_DB=true

# Kima Hub URL (manter para compatibilidade)
NEXT_PUBLIC_KIMA_HUB_URL=http://localhost:3000

# Módulo atual
NEXT_PUBLIC_KIMA_MODULE_KEY=faturas
